# Copia este archivo como .env para desarrollo local. NUNCA subas .env al repositorio.
# En Vercel, estas variables se pegan en Settings → Environment Variables.

# Base de datos (Neon en producción; Postgres local en desarrollo)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/portafolio
# Cadena larga y aleatoria (32+ caracteres): openssl rand -hex 32
PAYLOAD_SECRET=
# Otra cadena aleatoria distinta, para el hash de IP del formulario
RATE_LIMIT_SECRET=

# Dirección pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true mientras el sitio no deba aparecer en buscadores (vista previa)
NEXT_PUBLIC_NOINDEX=true
# Fase 6: true activa Vercel Web Analytics (sin cookies). Antes, actívalo en Vercel → Analytics → Enable.
NEXT_PUBLIC_ANALYTICS=false

# Vercel Blob (Vercel la crea sola al conectar el almacén Blob)
BLOB_READ_WRITE_TOKEN=

# Resend: avisos de contacto. El destino vive SOLO aquí.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
# Opcional: remitente; sin dominio propio se usa onboarding@resend.dev
CONTACT_FROM=

# Cloudflare Turnstile. Claves de PRUEBA públicas de Cloudflare (siempre aprueban);
# en producción se reemplazan por las reales.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Solo desarrollo local: true desactiva el TOTP (en producción se ignora)
TOTP_DISABLED=false
